#!/bin/sh
# hello-plugin — reference plugin for the Brokoli protocol tests.
#
# Implements the minimum surface of protocol v1 using only POSIX
# shell + awk, so the test doesn't depend on Python or any other
# interpreter being on the machine. Real plugins would almost
# certainly use the Python SDK and have richer behavior.
#
# Subcommands:
#   spec      → prints this plugin's manifest to stdout
#   check     → reads config from stdin, emits a status:ok
#   discover  → lists the "greetings" stream
#   plan      → breaks "greetings" into 2 work units (batch-1, batch-2)
#   read      → emits 3 record lines + 1 state line; if the params carry
#               a unit with an "offset" (from a prior plan), logs it first
#   write     → counts records from stdin, emits status with the count

set -eu
cmd="${1:-}"

case "$cmd" in
    spec)
        cat <<'EOF'
{"protocol_version":1,"name":"hello","version":"0.1.0","binary":"./bin","node_types":[{"type":"source_hello","kind":"source","supports_plan":true},{"type":"sink_hello","kind":"sink"}]}
EOF
        ;;
    check)
        # Read the config line off stdin (we don't actually use it; the
        # point is to prove the handshake works).
        read -r _config
        printf '{"type":"status","status":"ok","message":"ready"}\n'
        ;;
    discover)
        read -r _config
        printf '{"type":"stream","stream":{"name":"greetings","mode":"full_refresh","columns":[{"name":"id","type":"int"},{"name":"message","type":"string"}]}}\n'
        ;;
    plan)
        read -r _params
        printf '{"type":"work_unit","work_unit":{"unit_id":"batch-1","params":{"offset":0},"label":"first half"}}\n'
        printf '{"type":"work_unit","work_unit":{"unit_id":"batch-2","params":{"offset":2},"label":"second half"}}\n'
        ;;
    read)
        read -r params
        # If the host called ReadUnit, the params line carries a trailing
        # "unit":{"offset":N} (Unit is ReadParams's last field, so it's
        # last in the marshaled JSON whenever it's set). Surface it as a
        # log line so a test can prove the offset a `plan` call handed
        # out actually made it back to `read` unchanged.
        offset=$(printf '%s' "$params" | sed -n 's/.*"unit":{"offset":\([0-9]*\)}.*/\1/p')
        if [ -n "$offset" ]; then
            printf '{"type":"log","level":"info","message":"reading unit at offset %s"}\n' "$offset"
        fi
        printf '{"type":"log","level":"info","message":"emitting 3 greetings"}\n'
        printf '{"type":"record","data":{"id":1,"message":"hello world"}}\n'
        printf '{"type":"progress","progress":{"current":1,"total":3,"unit":"records","rows_out":1,"rate":1.5}}\n'
        printf '{"type":"record","data":{"id":2,"message":"hello brokoli"}}\n'
        printf '{"type":"progress","progress":{"current":2,"total":3,"unit":"records","rows_out":2,"rate":1.5}}\n'
        printf '{"type":"record","data":{"id":3,"message":"hello plugin"}}\n'
        printf '{"type":"progress","progress":{"current":3,"total":3,"unit":"records","rows_out":3,"rate":1.5}}\n'
        printf '{"type":"state","value":{"last_id":3}}\n'
        ;;
    write)
        # First line is the WriteParams header; subsequent lines are
        # records. Count them.
        read -r _header
        count=0
        while read -r line; do
            # skip empty
            [ -z "$line" ] && continue
            count=$((count + 1))
        done
        printf '{"type":"status","status":"ok","message":"wrote %d records"}\n' "$count"
        ;;
    *)
        printf '{"type":"error","message":"unknown command: %s"}\n' "$cmd" >&2
        exit 1
        ;;
esac
