{
  "name": "brokoli-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/community",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @brokoli/community",
    "build": "npm run build -w @brokoli/community",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:colors": "node scripts/check-raw-colors.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run test && npm run check:colors && npm run build && npm run check:boundaries",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "simple-icons": "^16.31.0"
  }
}
