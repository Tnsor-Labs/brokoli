{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    { "path": "../../packages/api" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/auth" },
    { "path": "../../packages/pipeline-session" },
    { "path": "../../packages/pipelines" },
    { "path": "../../packages/workspace" },
    { "path": "../../packages/observe" },
    { "path": "../../packages/shell" }
  ]
}
